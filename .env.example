TELEGRAM_BOT_TOKEN=
# Mode akses: yes (semua orang bisa akses), no (hanya ALLOWED_USERS)
PUBLIC=yes
# comma-separated telegram user IDs allowed, e.g. 7948712917,123456
ALLOWED_USERS=
# agy binary (PATH or absolute)
AGY_COMMAND=/home/container/.local/bin/agy
# workspace root (per-chat folder di bawah ini)
WORKSPACE_DIR=./workspace
DATA_DIR=./data
# default model, cek `agy models` setelah login
MODEL=gemini-3.8-flash-medium
MODE=auto
EFFORT=medium
